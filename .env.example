# Supabase server-side access. Never add either value to NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq assessment. Defaults to openai/gpt-oss-20b when GROQ_MODEL is omitted.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ntfy phone notifications. Topic can remain empty during code-only development.
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_SERVER=https://ntfy.sh

# Vercel Cron authorization. Required for the scheduled discovery route.
CRON_SECRET=

# Discovery tuning; the daily run rotates through 3 of 19 countries.
OSM_COUNTRIES_PER_RUN=3
GROQ_BATCHES_PER_RUN=2
NTFY_MIN_SCORE=70

