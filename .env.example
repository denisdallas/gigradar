PORT=3000
NODE_ENV=development
DATABASE_FILE=./data/gig-radar.sqlite

# Use distinct random values for the dashboard write key and scheduled-run key.
GIGRADAR_ADMIN_KEY=change-this-before-exposing-the-dashboard
CRON_SECRET=change-this-before-enabling-scheduled-runs

# Optional Groq qualification. Without a key, new items remain marked for review.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional ntfy notifications. Use a hard-to-guess private topic.
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_MIN_SCORE=75
